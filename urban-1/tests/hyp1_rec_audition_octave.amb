# REGRESSION: REC ARM with song stopped must audition native leads,
# modelled leads and procedural Sound FX, not just drums/poly keys.
# OCT +/- must transpose physical keys, NOT rewrite existing MIDI.
expect playing 0
tap REC
expect urbanrecstate 1
expect urbanrecoctave 0
# Native synth lead at catalog 16, never silent at song intro.
spin K1 -16
expect urbanrecprogram 16
expect urbanrectrack 8
tap OCT+
expect urbanrecoctave 1
key 7 down
expect urbanreckey7 72
wait 220
expect urbanacidlevel >0
key 7 up
# Modelled lead at 50, same audible keyboard path while STOPPED.
spin K1 34
expect urbanrecprogram 50
expect urbanrectrack 8
key 7 down
wait 220
expect urbanjazznotes >0
expect urbanjazzframes >0
key 7 up
# Procedural sound FX at 68: queue must reach actual DSP without PLAY.
spin K1 18
expect urbanrecprogram 68
expect urbanrectrack 8
tapkey 7
wait 300
expect urbansfxrendered >0
expect playing 0
# Both octave buttons work and saturate within -3..+3.
tap OCT-
expect urbanrecoctave 0
tap OCT-
expect urbanrecoctave -1
tap OCT+
expect urbanrecoctave 0
tap OCT+
expect urbanrecoctave 1
# Recording captures absolute MIDI 72 for key 7, rather than base 60.
tap REC
expect urbanrecstate 2
expect playing 1
tapkey 7
expect urbanreclastnote 72
tap OCT-
expect urbanrecoctave 0
tapkey 7
expect urbanreclastnote 60
expect urbanrecevents >2
tap REC
expect urbanrecstate 3
shot urban-rec-octave-piano-roll.png
tap HOME
expect urbanrecscreen 0
tap PLAY
expect playing 0
